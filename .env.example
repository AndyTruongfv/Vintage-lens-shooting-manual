# Supabase API Configuration for Vintage Lens Shooting Manual
# Điền thông tin Project URL và Anon Public Key lấy từ Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Tương thích nếu chạy trên các môi trường Next.js / framework khác:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
